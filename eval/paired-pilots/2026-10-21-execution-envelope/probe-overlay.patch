+// measuredJEVProbe serializes the same shape as jev.Client; all evaluation remains Fake.
+type measuredJEVProbe struct { jev.Evaluator; observe func([]byte,int) }
+func (m *measuredJEVProbe) Evaluate(ctx context.Context, state any, questions map[string]jev.Question) (*jev.Result,error) {
+ raw,err:=json.Marshal(map[string]any{"model":"jev-1.13.0","state":state,"questions":questions})
+ if err!=nil{return nil,err}
+ maxQuestion:=0
+ for name,q:=range questions {
+  one,err:=json.Marshal(map[string]any{"model":"jev-1.13.0","state":state,"questions":map[string]jev.Question{name:q}})
+  if err!=nil{return nil,err};if len(one)>maxQuestion{maxQuestion=len(one)}
+ }
+ m.observe(raw,maxQuestion)
+ return m.Evaluator.Evaluate(ctx,state,questions)
+}
