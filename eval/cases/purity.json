[
  {
    "id": "purity-sanitize-gear",
    "dimension": "purity",
    "title": "回复清洗：⚙ 独占工具行被剔除",
    "priority": "p0",
    "llm_script": [
      { "tool_call": { "tool": "get_balance", "args": "{}" } },
      { "reply": "⚙ get_balance\n你的余额为 2000.00 元。" }
    ],
    "turns": ["查余额"],
    "expect": {
