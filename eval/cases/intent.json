[
  {
    "id": "intent-balance-01",
    "dimension": "intent",
    "title": "查余额：意图 → get_balance 即时执行",
    "priority": "p0",
    "llm_script": [
      { "tool_call": { "tool": "get_balance", "args": "{}" } },
      { "reply": "你的可用余额为 2000.00 元，账本与投影一致。" }
    ],
    "turns": ["帮我查一下余额"],
    "expect": {
      "tools": ["get_balance"],
      "confirmed": false,
      "no_pending_final": true,
      "reply_contains": ["余额"],
      "env_reply_contains": ["2000.00"],
      "reply_not": ["⚙", "get_balance"]
    }
  },
  {
    "id": "intent-balance-02",
    "dimension": "intent",
    "title": "口语化提问也能路由到余额",
    "priority": "p1",
    "llm_script": [
      { "tool_call": { "tool": "get_balance", "args": "{}" } },
      { "reply": "当前余额 2000.00 元。" }
    ],
    "turns": ["我还有多少钱？"],
    "expect": {
      "tools": ["get_balance"],
      "no_pending_final": true,
      "env_reply_contains": ["2000.00"]
    }
  },
