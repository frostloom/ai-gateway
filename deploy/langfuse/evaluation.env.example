# Public overrides for the previously selected channel. Contains no credentials.
# Read .env first, then the private Langfuse project .env.agent, then this file.
AGENT_LLM_BASE_URL=https://maas.qianwenaiapi.com/apps/anthropic
AGENT_LLM_MODEL=deepseek-v4.1-flash
AGENT_LLM_PROTOCOL=anthropic
JEV_MODEL=jev-1.13.0
AGENT_LANGFUSE_ENVIRONMENT=evaluation
AGENT_LANGFUSE_SAMPLE_RATE=1
# Enable only for this synthetic evaluation project, not as a production default.
AGENT_LANGFUSE_CAPTURE_CONTENT=true
