# Separate agent configuration, not Langfuse server database credentials.
# The application defaults to disabled. Supply project keys after creating Langfuse projects.
AGENT_LANGFUSE_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:13000/api/public/otel/v1/traces
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AGENT_LANGFUSE_HASH_KEY=
AGENT_LANGFUSE_ENVIRONMENT=evaluation
AGENT_LANGFUSE_SAMPLE_RATE=1
AGENT_LANGFUSE_CAPTURE_CONTENT=false
AGENT_RELEASE=
