# Separate from gateway .env; generate independent secrets, never copy model keys.
# Hex secrets avoid URL/Compose escaping surprises. ENCRYPTION_KEY must be 64 hex digits.
LF_WEB_PORT=13000
LF_MINIO_PORT=19090
LF_POSTGRES_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_PASSWORD=
LF_MINIO_PASSWORD=
LF_SALT=
LF_NEXTAUTH_SECRET=
LF_ENCRYPTION_KEY=

# Optional headless local initialization (independent project API keys).
LF_INIT_ORG_ID=
LF_INIT_ORG_NAME=
LF_INIT_PROJECT_ID=
LF_INIT_PROJECT_NAME=
LF_INIT_PROJECT_PUBLIC_KEY=
LF_INIT_PROJECT_SECRET_KEY=
LF_INIT_USER_EMAIL=
LF_INIT_USER_NAME=
LF_INIT_USER_PASSWORD=
