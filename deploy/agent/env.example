# Copy to .env.agent (ignored, chmod 600), fill locally. No working secrets included.
AGENT_KNOWLEDGE_ENABLED=false
AGENT_CONTAINER_PORT=19105
CONTROL_PLANE_TOKEN=
MYSQL_DSN=root:CHANGE_ME@tcp(host.docker.internal:3307)/ai_gateway?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=host.docker.internal:6381
REDIS_PASSWORD=
BILLING_ADDR=host.docker.internal:9101
BILLING_ADMIN_ADDR=http://host.docker.internal:9103
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_PROTOCOL=openai
AGENT_ROUTING_MODE=model
AGENT_LANGFUSE_ENABLED=false
AGENT_LANGFUSE_CAPTURE_CONTENT=false
AGENT_LANGFUSE_SAMPLE_RATE=1
AGENT_LANGFUSE_ENVIRONMENT=evaluation
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:13000/api/public/otel/v1/traces
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AGENT_LANGFUSE_HASH_KEY=
# If required: HTTPS_PROXY=http://host.docker.internal:YOUR_PORT
# If corporate CA is needed: build a reviewed image including that CA; never disable TLS verification.
